# Server Port (Render sets this dynamically in production, defaults to 8080 locally)
PORT=8080

# Optional Host Binding (defaults to 0.0.0.0 or dual-stack ::)
HOST=0.0.0.0

# Optional AI Weather Assistant Keys
# If not provided, the dashboard utilizes its built-in deterministic
# meteorological reasoning engine over genuine Open-Meteo observations.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
